datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  password     String
  role         String             @default("RESIDENT") // "RESIDENT" or "ADMIN"
  flatNumber   String?
  phone        String?
  createdAt    DateTime           @default(now())
  
  // Relations
  complaints   Complaint[]        @relation("ResidentComplaints")
  assigned     Complaint[]        @relation("AssignedComplaints")
  historyLogs  ComplaintHistory[] @relation("ChangedByUser")
  notices      Notice[]           @relation("NoticeAuthor")
}

model Complaint {
  id            String             @id @default(uuid())
  residentId    String
  resident      User               @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: Cascade)
  assignedToId  String?
  assignedTo    User?              @relation("AssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  category      String             // "Plumbing", "Electrical", "Lift", "Security", etc.
  title         String
  description   String
  photoUrl      String?
  priority      String             @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  status        String             @default("OPEN")   // "OPEN", "IN_PROGRESS", "RESOLVED"
  
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  resolvedAt    DateTime?
  
  // Relations
  history       ComplaintHistory[] @relation("ComplaintToHistory")
}

model ComplaintHistory {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation("ComplaintToHistory", fields: [complaintId], references: [id], onDelete: Cascade)
  
  changedById  String
  changedBy    User      @relation("ChangedByUser", fields: [changedById], references: [id], onDelete: Cascade)
  
  fromStatus   String?
  toStatus     String
  adminNote    String?
  timestamp    DateTime  @default(now())
}

model Notice {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  title       String
  content     String
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key   String @id @unique
  value String
}
