# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=supersecretjwtkey12345!@#$

# Database Connection (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# Cloudinary Configuration (Optional - fallback to local storage if empty)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# SMTP Configuration (Optional - fallback to console logger if empty)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Society Tracker <noreply@society.com>"

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api
